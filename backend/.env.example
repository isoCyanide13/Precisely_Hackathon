# Application Settings
PROJECT_NAME="Precisely Backend API"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# CORS Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://precisely-hackathon-856a.vercel.app"]

# Database Configuration
# Default to SQLite for quick local setup. Switch to PostgreSQL for production.
# SQLite example: sqlite:///./sql_app.db
# PostgreSQL example: postgresql+psycopg2://postgres:password@localhost:5432/precisely_db
DATABASE_URL="sqlite:///./sql_app.db"
